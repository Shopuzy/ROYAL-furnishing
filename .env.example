# =============================================================================
# ROYAL FURNISHING — Environment Variables (Cloudflare Pages + Supabase Free)
# Never put your Supabase service_role key in any VITE_ variable!
# Only the public Project URL and public anon key belong here.
# =============================================================================

# Use Supabase Publishable (or Anon) public key — NEVER a service_role or sb_secret_ key.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
# Optional: Explicit production URL (e.g. https://yourdomain.com) for password recovery links
VITE_SITE_URL="https://your-site.pages.dev"
